<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Credential Manager los agrega para llaves de acceso con huella; Centavot no los usa (informe de seguridad). -->
    <!-- Sincronización con el backend de Centavot. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" tools:node="remove" />

    <application
        android:name=".CentavotApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/reglas_extraccion"
        android:fullBackupContent="@xml/reglas_respaldo"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Comparte el reporte exportado sin exponer el resto de archivos de la app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
        <!-- Pantallas de Firebase Auth para ingresar por el navegador (otros proveedores y reCAPTCHA del teléfono).
             Centavot entra con Credential Manager y no las usa: se quitan para no dejarlas abiertas a otras apps. -->
        <activity android:name="com.google.firebase.auth.internal.GenericIdpActivity" tools:node="remove" />
        <activity android:name="com.google.firebase.auth.internal.RecaptchaActivity" tools:node="remove" />
    </application>

</manifest>